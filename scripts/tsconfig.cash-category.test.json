{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "outDir": "./dist",
    "rootDir": "..",
    "noEmit": false,
    "isolatedModules": false,
    "paths": {
      "@/*": ["../*"]
    },
    "skipLibCheck": true
  },
  "include": [
    "./test-cash-category.ts",
    "../lib/transactions/cash-category.ts",
    "../lib/transactions/expense-tags.ts",
    "../lib/cash-flow.ts",
    "../lib/data/contribution-sources.ts"
  ]
}
